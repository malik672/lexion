# Obtain a token from your Tycho provider.
TYCHO_API_KEY=
TYCHO_HOST=tycho-fynd-ethereum.propellerheads.xyz
RPC_URL=

# Personal defaults. Command-line flags override these values.
WALLET_ADDRESS=
RECIPIENT_ADDRESS=
TOKEN_IN=0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48
TOKEN_OUT=0xc02aaa39b223fe8d0a0e5c4f27ead9083c756cc2
AMOUNT=1000000000
SLIPPAGE_BPS=30
MAX_HOPS=2
MIN_TVL=10

# Optional exact output-token cost of one unit of gas. Leave numerator zero when unavailable.
GAS_COST_NUMERATOR=0
GAS_COST_DENOMINATOR=1
